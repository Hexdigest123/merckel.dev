# =============================================================================
# Application
# =============================================================================
# SvelteKit ORIGIN — REQUIRED in production for CSRF protection
ORIGIN=https://merckel.dev

# Number of trusted reverse proxies in front of the app that append the client
# address to X-Forwarded-For. Used to identify clients for rate limiting, so it
# must match your setup (e.g. 2 for Cloudflare -> nginx -> app).
XFF_DEPTH=1

# =============================================================================
# Database
# =============================================================================
# Direct connection string (used by `bun run dev` and drizzle-kit on the host).
# docker-compose builds its own URL from the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/merckel

# Credentials used by docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merckel
# Major version of the postgres image. The data volume is mounted at
# /var/lib/postgresql, which is the layout of the 18+ images. Older images keep
# their data in an anonymous volume that is not reused after `docker compose down`,
# so every redeploy would start with an empty database.
POSTGRES_VERSION=18

# Host port for a local docker-compose.override.yml that exposes the database.
# Never expose the database in production.
POSTGRES_EXPOSE_PORT=5432

# =============================================================================
# DB Connection Retry (app-level backoff)
# =============================================================================
# Reconnect delay doubles from the base delay up to DB_MAX_RETRIES times (max 5s).
DB_MAX_RETRIES=3
DB_RETRY_BASE_DELAY_MS=200

# =============================================================================
# Docker Compose — Deploy / Restart Backoff
# =============================================================================
RESTART_DELAY=5s
RESTART_MAX_ATTEMPTS=5
RESTART_WINDOW=120s

# =============================================================================
# GitHub API (optional — open source section uses fallback data without it)
# =============================================================================
GITHUB_TOKEN=

# =============================================================================
# Contact form (nodemailer)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
